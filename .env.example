# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# VAPI API Configuration
VAPI_API_KEY=your-vapi-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Firebase Configuration (from Firebase Console)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# Firebase Admin SDK (Optional - for server-side operations)
FIREBASE_CREDENTIALS_PATH=path/to/serviceAccountKey.json

# Example Firebase Configuration (replace with your actual values)
# FIREBASE_API_KEY=AIzaSyA6_E7itGE4WB2mu-_W_44xn1dBw6NHvM8
# FIREBASE_AUTH_DOMAIN=vapi-demo-auth.firebaseapp.com
# FIREBASE_PROJECT_ID=vapi-demo-auth
# FIREBASE_STORAGE_BUCKET=vapi-demo-auth.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=1089810653158
# FIREBASE_APP_ID=1:1089810653158:web:750b0f7399c9ebf9d40027
# FIREBASE_DATABASE_URL=https://vapi-demo-auth.firebaseio.com
